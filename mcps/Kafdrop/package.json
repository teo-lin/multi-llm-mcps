{
  "name": "@teolin/mcp-kafdrop",
  "version": "3.3.7",
  "private": true,
  "author": "Teolin",
  "license": "MIT",
  "description": "MCP server for inspecting Kafka clusters via Kafdrop Web UI",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kafka",
    "kafdrop",
    "messaging",
    "streaming",
    "monitoring"
  ],
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {

# AWS Configuration for CloudWatch Logs
# Optional - if not provided, will use default AWS credentials chain
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Optional: For temporary credentials
# AWS_SESSION_TOKEN=your_session_token

# Restrict CloudWatch queries to specific log groups (comma-separated, optional)
# If set, only these log groups will be available for querying
ALLOWED_LOG_GROUPS=your-log-group-1,your-log-group-2

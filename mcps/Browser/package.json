{
  "name": "browser",
  "version": "1.3.0",
  "description": "A local Chrome browser automation MCP server powered by Puppeteer for any agent",
  "main": "mcp-server.js",
  "bin": {
    "browser": "mcp-server.js"
  },
  "scripts": {
    "start": "node mcp-server.js",
    "server": "node server.js",
    "postinstall": "echo 'browser installed. Add to any agent with: claude mcp add --scope user browser -- node \"'\"$PWD\"'/mcp-server.js\"'"
  },
  "keywords": [
    "mcp",
    "puppeteer",
    "chrome",
    "browser-automation",
    "ai-agent",
    "model-context-protocol"
  ],
  "author": "claude",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo-lin/multi-llm-mcps.git",
    "directory": "mcps/Browser"
  },
  "homepage": "https://github.com/teo-lin/multi-llm-mcps/tree/main/mcps/Browser#readme",
  "bugs": {
    "url": "https://github.com/teo-lin/multi-llm-mcps/issues"
  },
  "files": [
    "browser-manager.js",
    "mcp-server.js",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "puppeteer": "^24.38.0"
  }
}

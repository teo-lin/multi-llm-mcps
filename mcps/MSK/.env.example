# AWS Configuration for MSK
# Optional - if not provided, will use default AWS credentials chain
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Optional: For temporary credentials (IAM role assumption)
# AWS_SESSION_TOKEN=your_session_token

# MSK Authentication Type
# Options: PLAINTEXT, TLS, IAM
MSK_AUTH_TYPE=TLS

# Kafka Connection Settings (optional overrides)
KAFKA_CONNECTION_TIMEOUT=30000
KAFKA_REQUEST_TIMEOUT=30000

# Debug Mode (set to true for detailed logging)
DEBUG=false

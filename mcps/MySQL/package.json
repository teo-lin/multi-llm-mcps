{
  "name": "@teolin/mcp-local-mysql",
  "version": "3.1.2",
  "author": "Teolin",
  "license": "MIT",
  "description": "MCP server for local MySQL database operations",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mysql",
    "database",
    "sql",
    "claude",
    "claude-code",
    "server"
  ],
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mysql-mcp": "src/index.js"
  },
  "files": [
    "src/**/*.js",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "test": "node src/test.js",
    "prepublishOnly": "chmod +x src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "mysql2": "^3.11.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo-lin/multi-llm-mcps.git",
    "directory": "mcps/MySQL"
  }
}

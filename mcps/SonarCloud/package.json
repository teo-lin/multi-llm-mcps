{
  "name": "@teolin/mcp-sonarcloud",
  "version": "1.0.0",
  "author": "Teolin",
  "license": "MIT",
  "description": "MCP server for SonarCloud/SonarQube code quality analysis and issue management",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sonarcloud",
    "sonarqube",
    "code-quality",
    "static-analysis",
    "security",
    "code-smells",
    "bugs",
    "vulnerabilities",
    "claude",
    "claude-code"
  ],
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "sonarcloud-mcp": "src/index.js"
  },
  "files": [
    "src/**/*.js",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node src/test.js",
    "prepublishOnly": "chmod +x src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo-lin/multi-llm-mcps.git",
    "directory": "mcps/SonarCloud"
  }
}

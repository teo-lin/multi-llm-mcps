# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net

# Authentication - Choose at least one method:

# Method 1: OAuth via Atlassian CLI (acli) - Recommended
# Requires: acli installed and authenticated
JIRA_SITE=your-domain.atlassian.net

# Method 2: Basic Auth with API Token
# Get your token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your.email@domain.com
JIRA_READ_TOKEN=your_jira_api_token_with_read_only_rights
JIRA_EDIT_TOKEN=your_jira_token_with_classic_or_granular_edit_rights

# Authentication Strategy (optional, default: auto)
# - auto: Try OAuth first, fallback to Basic Auth
# - oauth: Use OAuth only (requires acli)
# - basic: Use Basic Auth only (requires email + token)
JIRA_AUTH_STRATEGY=auto

# Optional: Defaults for ticket creation
JIRA_DEFAULT_PROJECT=PAB
JIRA_TEAM_BOARD_ID=114
JIRA_BUGS_BOARD_ID=155

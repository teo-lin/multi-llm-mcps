    "README.md",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo-lin/multi-llm-mcps.git",
    "directory": "mcps/Kafdrop"

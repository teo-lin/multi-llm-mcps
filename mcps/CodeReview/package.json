{
  "name": "@teolin/code-review-agent",
  "version": "3.0.0",
  "author": "Teolin",
  "license": "MIT",
  "description": "MCP server for automated code reviews with GitHub PR and Jira integration",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-review",
    "github",
    "jira",
    "pull-request",
    "pr",
    "claude",
    "claude-code",
    "automation",
    "atlassian"
  ],
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "codereview-mcp": "src/index.js"
  },
  "files": [
    "src/**/*.js",
    "README.md"
  ],
  "engines": {
    "node": ">=25.2.1"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node src/test.js",
    "prepublishOnly": "chmod +x src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo-lin/multi-llm-mcps.git",
    "directory": "mcps/CodeReview"
  }
}

{
  "name": "@teolin/mcp-cloudwatch-logs",
  "version": "3.1.3",
  "author": "Teolin",
  "license": "MIT",
  "description": "MCP server for querying AWS CloudWatch Logs with Log Insights",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aws",
    "cloudwatch",
    "logs",
    "log-insights",
    "claude",
    "claude-code",
    "monitoring",
    "observability"
  ],
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "cloudwatch-mcp": "src/index.js"
  },
  "files": [
    "src/**/*.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node src/test.js",
    "prepublishOnly": "chmod +x src/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.600.0",
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo-lin/multi-llm-mcps.git",
    "directory": "mcps/CloudWatch"
  }
}

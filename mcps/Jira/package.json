{
  "name": "@teolin/mcp-jira",
  "version": "3.3.1",
  "author": "Teolin",
  "license": "MIT",
  "description": "Model Context Protocol server for Doctari Jira integration",
  "keywords": [
    "mcp",
    "jira",
    "atlassian"
  ],
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "test": "node src/test.js",
    "prepublishOnly": "chmod +x src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.0"
  },
  "bin": {
    "jira-mcp": "src/index.js"
  },
  "files": [
    "src/**/*.js",
    "README.md",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo-lin/multi-llm-mcps.git",
    "directory": "mcps/Jira"
  }
}
